   "text": "Ein Grab aus Steinplatten, älter als jede Karte. Der Wind pfeift durch die Fugen.",
   "feldweg": false,
   "abseits": true,
   "region": "fl_186_169"
  },
  {
   "name": "Die Windharfe",
   "art": "turm",
   "artname": "Wachturm",
   "land": "Fahle Weiten",
   "x": 6184,
   "y": 5582,
   "besonders": true,
   "text": "Ein verlassener Turm, durch dessen Ritzen der Wind singt. In Sturmnächten hört man ihn bis Grauwacht.",
   "feldweg": false,
   "abseits": true,
   "region": "fl_186_169"
  },
  {
   "name": "Krähenbaum",
   "art": "schrein",
   "artname": "Schrein",
   "land": "Fahle Weiten",
   "x": 5998,
   "y": 5754,
   "besonders": true,
   "text": "Ein toter Baum voller Krähen. Die Heideleute hängen Knochen hinein – gegen den Frost.",
   "feldweg": false,
   "abseits": true,
   "region": "fl_186_169"
  },
